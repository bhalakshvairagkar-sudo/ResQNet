# ResQNet Central AI & Emergency Dispatch Configuration
# Copy to .env and configure for your local or production environment

# Server Port
PORT=5000

# MongoDB Connection String (Leave empty to use memory-store for testing)
MONGODB_URI=mongodb://127.0.0.1:27017/resqnet

# OSRM Street Routing Server
OSRM_BASE_URL=https://router.project-osrm.org

# Real-Time WebSocket Endpoint
SOCKET_URL=http://localhost:5000

# Operation Mode: true for client-side demo simulations, false for real hardware/API operation
DEMO_MODE=false

# Server-side demo credentials (never expose this value in browser JavaScript)
DEMO_PASSWORD=configurable-demo-password
COMMAND_CENTER_USER=operator

# Real YOLO Vision Detection Service Endpoint
AI_SERVICE_URL=http://localhost:5001

# Mobile Android Developer LAN IP (Replace with your computer's Wi-Fi IPv4)
DEV_BACKEND_URL=http://192.168.1.11:5000
