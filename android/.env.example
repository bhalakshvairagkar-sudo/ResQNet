# ResQNet Android configuration
# Production: replace with the public URL of the Render Web Service.
# Do not add /api here; the Android API client appends route paths.
RESQNET_BACKEND_URL=https://your-resqnet-backend.onrender.com/
RESQNET_API_KEY=copy-the-same-value-configured-in-Render

# Local emulator alternative: http://10.0.2.2:5000/
# Local physical-phone alternative: http://YOUR_PC_WIFI_IP:5000/
